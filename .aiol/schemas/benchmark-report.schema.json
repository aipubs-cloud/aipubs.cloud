{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aipubs.cloud/schemas/p2cs/benchmark-report.schema.json",
  "title": "P2CS Benchmark Report",
  "description": "Benchmark results for a generated component or experiment",
  "type": "object",
  "required": ["schema_version", "benchmark_id", "component_or_experiment_id", "metrics", "provenance"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "benchmark_id": { "type": "string" },
    "component_or_experiment_id": { "type": "string" },
    "run_at": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "properties": {
        "os": { "type": "string" },
        "cpu": { "type": "string" },
        "memory_gb": { "type": "number" },
        "gpu": { "type": "string" },
        "runtime": { "type": "string" },
        "runtime_version": { "type": "string" }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "value", "unit"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "number" },
          "unit": { "type": "string" },
          "lower_is_better": { "type": "boolean" },
          "baseline": { "type": "number" },
          "delta_percent": { "type": "number" }
        }
      }
    },
    "passed": { "type": "boolean" },
    "notes": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["publication_id", "workflow_id", "generated_at", "repository_commit", "integrity_hash"],
      "properties": {
        "publication_id": { "type": "string" },
        "workflow_id": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "repository_commit": { "type": "string" },
        "integrity_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
