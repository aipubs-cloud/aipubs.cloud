{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aipubs.cloud/schemas/p2cs/plugin-descriptor.schema.json",
  "title": "P2CS Plugin Descriptor",
  "description": "Manifest describing a P2CS plugin and its lifecycle hooks",
  "type": "object",
  "required": ["schema_version", "plugin_id", "name", "version", "hooks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "plugin_id": { "type": "string" },
    "name": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "license": { "type": "string" },
    "language": { "type": "string" },
    "entrypoint": { "type": "string", "description": "Command or module path to invoke the plugin" },
    "hooks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["event", "handler"],
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "publication.discovered",
              "publication.parsed",
              "semantic_graph.created",
              "synthesis.requested",
              "experiment.generated",
              "validation.completed",
              "benchmark.completed",
              "artifact.published"
            ]
          },
          "handler": { "type": "string", "description": "Handler function or endpoint" },
          "priority": { "type": "integer", "minimum": 0, "maximum": 100, "default": 50 },
          "async": { "type": "boolean", "default": false }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "AIOL capability identifiers required by this plugin"
    },
    "configuration_schema": {
      "type": "object",
      "description": "JSON Schema for plugin configuration",
      "additionalProperties": true
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "object", "required": ["plugin_id", "version"], "properties": { "plugin_id": { "type": "string" }, "version": { "type": "string" } } }
    }
  }
}
