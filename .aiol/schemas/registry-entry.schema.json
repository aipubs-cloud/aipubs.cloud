{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aipubs.cloud/schemas/p2cs/registry-entry.schema.json",
  "title": "P2CS Registry Entry",
  "description": "An entry in the P2CS component registry",
  "type": "object",
  "required": ["schema_version", "entry_id", "type", "name", "version", "provenance"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "entry_id": { "type": "string" },
    "type": { "type": "string", "enum": ["library", "aiol_module", "experiment", "dataset", "benchmark", "prompt", "documentation"] },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "language_targets": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "path": { "type": "string", "description": "Relative path within repository" },
    "manifest_path": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": { "type": "object", "required": ["entry_id", "version"], "properties": { "entry_id": { "type": "string" }, "version": { "type": "string" } } }
    },
    "semantic_version": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "deprecated", "experimental", "archived"] },
    "provenance": {
      "type": "object",
      "required": ["publication_id", "workflow_id", "generated_at", "repository_commit"],
      "properties": {
        "publication_id": { "type": "string" },
        "workflow_id": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "repository_commit": { "type": "string" },
        "integrity_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    }
  }
}
