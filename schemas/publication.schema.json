{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aipubs.cloud/schemas/publication.schema.json",
  "title": "AIPubs.cloud Publication Manifest",
  "description": "Schema for a publication manifest (publication.json) — the provenance record for a research object on AIPubs.cloud",
  "type": "object",
  "required": ["id", "title", "authors", "version", "license", "date"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable unique identifier for this publication (e.g. paper-001)"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "description": "Full publication title"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered list of authors",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name":        { "type": "string" },
          "given":       { "type": "string" },
          "family":      { "type": "string" },
          "orcid":       { "type": "string", "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[0-9X]$" },
          "affiliation": { "type": "string" },
          "email":       { "type": "string" }
        }
      }
    },
    "version": {
      "type": "string",
      "description": "Semantic version of this publication (e.g. 1.0, 1.1, 2.0)"
    },
    "license": {
      "type": "string",
      "enum": ["CC-BY-4.0", "CC-BY-SA-4.0", "CC-BY-NC-4.0", "CC-BY-NC-SA-4.0", "MIT", "Apache-2.0", "CC0-1.0"],
      "description": "SPDX license identifier"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Publication date (YYYY-MM-DD)"
    },
    "abstract": {
      "type": "string",
      "description": "Short abstract (150–250 words recommended)"
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Keywords for discovery and indexing"
    },
    "category": {
      "type": "string",
      "description": "Primary research category"
    },
    "doi": {
      "type": "string",
      "description": "Digital Object Identifier once assigned"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Canonical URL for this publication on AIPubs.cloud"
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "description": "Link to the source repository (GitHub, etc.)"
    },
    "hash": {
      "type": "string",
      "description": "SHA-256 content fingerprint of the primary artifact (ACF)"
    },
    "raip": {
      "type": "string",
      "description": "Path or URL to the associated RAIP envelope file"
    },
    "datasets": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths or URLs to associated datasets"
    },
    "code": {
      "type": "string",
      "format": "uri",
      "description": "URL to associated code repository"
    },
    "version_history": {
      "type": "array",
      "description": "Ordered version history of this publication",
      "items": {
        "type": "object",
        "required": ["version", "date"],
        "properties": {
          "version":     { "type": "string" },
          "date":        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "description": { "type": "string" },
          "hash":        { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "RAIP provenance metadata",
      "properties": {
        "acf":    { "type": "string", "description": "Artifact Content Fingerprint (SHA-256)" },
        "alc":    { "type": "string", "description": "Artifact Lifecycle Chain hash" },
        "signer": { "type": "string", "description": "Signing key or identity" },
        "status": { "type": "string", "enum": ["Verified", "Pending vectors", "Revoked"] },
        "vectors":{ "type": "string" }
      }
    },
    "funding": {
      "type": "string",
      "description": "Funding acknowledgement"
    },
    "grants": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Grant identifiers"
    },
    "ethics": {
      "type": "string",
      "description": "Ethics statement"
    },
    "conflicts": {
      "type": "string",
      "description": "Conflicts of interest statement"
    }
  }
}
